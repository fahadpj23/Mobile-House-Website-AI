rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Products — public read, authenticated write/delete
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Banners — public read, authenticated write/delete
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Special offers — public read, authenticated write/delete
    match /offers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Brands — public read, authenticated write/delete
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else: deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}